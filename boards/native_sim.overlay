#include <zephyr/dt-bindings/adc/adc.h>

/ {
    oresat_demo: oresat-demo-enabled {}; // Enable demos for supported boards

    chosen {
        zephyr,canbus = &can0;
    };

    aliases {
        adc0 = &adc;
        /* can0 = &can; */
    };

    adc: adc {
        compatible = "zephyr,adc-emul";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        nchannels = <32>;
        ref-internal-mv = <1>;

        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_1";
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,vref-mv = <3300>;
            zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,2)>;
            zephyr,resolution = <12>;
            zephyr,oversampling = <5>;
            zephyr,input-positive = <0>;
        };
    };

    can: can {
        compatible = "zephyr,native-linux-can";
        status = "okay";
        host-interface = "zcan0";
        bitrate = <1000>;
    };
};

