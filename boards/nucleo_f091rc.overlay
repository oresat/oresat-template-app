#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/pinctrl/stm32-pinctrl.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

#include "nucleo_f091rc-pinctrl.dtsi"

/ {
    oresat_demo: oresat-demo-enabled {}; // Enable demos for supported boards

    zephyr,user {
        dac = <&dac1>;
        dac_channel_id = <1>;
        dac_resolution = <12>;
    };

    aliases {
        dac0 = &dac1;
        adc0 = &adc1;
        i2c0 = &i2c1;
        led0 = &myled0;
    };

    leds {
        compatible = "gpio-leds";
        myled0: led_0 {
            gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
        };
    };
};

&dma1 {
    status = "okay";
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
    pinctrl-0 = <&adc1_in0_pa0 &adc1_in1_pa1>;
    pinctrl-names = "default";
    dmas = <&dma1 1 (STM32_DMA_PERIPH_RX |
                     STM32_DMA_PRIORITY_HIGH |
                     STM32_DMA_PERIPH_16BITS |
                     STM32_DMA_MEM_16BITS)>;
    dma-names = "rx";

	adc1_0: channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 240)>;
		zephyr,resolution = <12>;
        zephyr,oversampling = <5>;
        /delete-property/ zephyr,differential;
	};
	adc1_1: channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 240)>;
		zephyr,resolution = <12>;
        zephyr,oversampling = <5>;
        /delete-property/ zephyr,differential;
	};
};

&dac1 {
    status = "okay";
    pinctrl-0 = <&dac1_out1_pa4>;
    pinctrl-names = "default";
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	bme280: bme280@77 {
		compatible = "bosch,bme280";
		reg = <0x77>;
        status = "okay";
	};
};
